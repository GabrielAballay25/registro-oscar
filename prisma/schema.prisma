datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Usuario único Administrador
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// 2. Clientes (ABMC)
model Customer {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  phone     String?
  address   String?
  notes     String?
  sales     Sale[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 3. Catalogo de Productos
model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  stock       Int      @default(0)
  sales       Sale[]
  createdAt   DateTime @default(now())
}

// 4. Registro de Ventas: un producto por venta, con plan de cuotas propio
model Sale {
  id                String    @id @default(uuid())
  customerId        String
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  productId         String
  product           Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity          Int       @default(1)
  saleDate          DateTime // Fecha en la que se pactó la venta
  installmentAmount Decimal   @db.Decimal(10, 2) // Monto acordado por cuota
  paymentFrequency  String // "SEMANAL" | "QUINCENAL" | "MENSUAL"
  firstDueDate      DateTime // Fecha del primer cobro
  installmentCount  Int // Cantidad de cuotas pactadas
  notes             String?
  status            String    @default("PENDIENTE") // "PENDIENTE", "PARCIAL", "COMPLETADO"
  payments          Payment[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// 5. Registro de Cobros / cuotas
model Payment {
  id            String   @id @default(uuid())
  saleId        String
  sale          Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amountPaid    Decimal  @db.Decimal(10, 2) // Monto exacto que entregó el cliente en esta cuota
  paymentDate   DateTime // Fecha del cobro
  paymentMethod String   @default("Efectivo")
  note          String?
  createdAt     DateTime @default(now())
}

// 6. Cierre de Caja Semanal
model WeeklyClosure {
  id          String   @id @default(uuid())
  startDate   DateTime // Lunes
  endDate     DateTime // Domingo
  totalAmount Decimal  @db.Decimal(10, 2) // Suma total cobrada en la semana
  closedAt    DateTime @default(now())
}
